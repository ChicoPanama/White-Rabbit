    "monitoring_rules": {
      "transaction_patterns": {
        "precision_exploit": {
          "pattern": "repeated_small_deposits",
          "threshold": "> 100 transactions < 0.001 ETH in 1 hour",
          "alert_level": "HIGH"
        },
        "bridge_manipulation": {
          "pattern": "consensus_threshold_reached_quickly", 
          "threshold": "validator signatures gathered in < 60 seconds",
          "alert_level": "CRITICAL"
        },
        "flash_loan_reentrancy": {
          "pattern": "external_call_during_loan",
          "threshold": "flash loan + external call + state change",
          "alert_level": "HIGH"
        },
        "signature_replay": {
          "pattern": "identical_signature_multiple_chains",
          "threshold": "same signature hash on >1 chain in 24h", 
          "alert_level": "MEDIUM"
        },
        "donation_manipulation": {
          "pattern": "large_direct_transfer_before_price_query",
          "threshold": "> $100k direct transfer + price query in same block",
          "alert_level": "HIGH"
        }
      },
      
      "code_patterns": {
        "deployment_analysis": true,
        "upgrade_monitoring": true,
        "governance_proposal_analysis": true,
        "validator_set_changes": true
      }
    },
    
    "alerting": {
      "channels": {
        "telegram": {
          "enabled": true,
          "critical_only": false,
          "chat_id": "whiterabbit_alerts"
        },
        "email": {
          "enabled": true,
          "critical_only": true,
          "recipients": ["security@whiterabbit.com"]
        },
        "webhook": {
          "enabled": true,
          "url": "https://api.whiterabbit.com/alerts",
          "auth_header": "Bearer ${WEBHOOK_TOKEN}"
        }
      },
      
      "rate_limiting": {
        "max_alerts_per_hour": 50,
        "duplicate_suppression_minutes": 30,
        "escalation_threshold": 5
      }
    },
    
    "integration": {
