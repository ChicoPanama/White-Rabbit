        "graph_protocol": true,
        "mempool_monitoring": true,
        "social_sentiment": true
      },
      
      "output_formats": {
        "json_reports": true,
        "pdf_analysis": true,
        "api_endpoints": true,
        "real_time_dashboard": true
      }
    },
    
    "machine_learning": {
      "enabled": true,
      "models": {
        "anomaly_detection": {
          "type": "isolation_forest",
          "features": ["transaction_patterns", "value_distributions", "timing_analysis"]
        },
        "exploit_prediction": {
          "type": "gradient_boosting",
          "features": ["code_complexity", "pattern_combinations", "historical_context"]
        },
        "false_positive_reduction": {
          "type": "neural_network",
          "features": ["context_analysis", "developer_reputation", "audit_status"]
        }
      },
      
      "training_data": {
        "exploit_database": "403_hack_comprehensive",
        "safe_contracts": "audited_protocols_database",
