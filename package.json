{
  "name": "@whiteclaws/monorepo",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "WhiteClaws monorepo - Smart contract security tools",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@whiteclaws/white-rabbit && npm run build --workspace=@whiteclaws/mcp-white-rabbit",
    "build:watch": "npm run build:watch --workspaces",
    "test": "npm run test --workspaces",
    "test:core": "npm run test --workspace=@whiteclaws/white-rabbit",
    "test:mcp": "npm run test --workspace=@whiteclaws/mcp-white-rabbit",
    "test:ci": "npm run test:ci --workspace=@whiteclaws/white-rabbit",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules",
    "clean:dist": "rm -rf packages/*/dist",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc --build packages/*/tsconfig.json --noEmit",
    "prepare": "npm run build",
    "version": "npm version --workspaces",
    "publish:alpha": "npm publish --workspaces --tag alpha --access public",
    "publish:beta": "npm publish --workspaces --tag beta --access public",
    "publish:latest": "npm publish --workspaces --access public",
    "benchmark": "npm run benchmark --workspace=@whiteclaws/white-rabbit",
    "audit:security": "npm audit --workspaces --audit-level=moderate",
    "audit:fix": "npm audit fix --workspaces",
    "deps:check": "npm outdated --workspaces",
    "deps:update": "npm update --workspaces"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChicoPanama/White-Rabbit.git"
  },
  "keywords": [
    "smart-contract",
    "security",
    "vulnerability-scanner",
    "defi",
    "whiteclaws"
  ],
  "license": "MIT"
}
