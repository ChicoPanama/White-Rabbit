{
  "name": "white-rabbit",
  "version": "1.0.0",
  "description": "Autonomous smart contract vulnerability scanner for DeFi protocols",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "audit": "tsx src/cli.ts audit",
    "scan": "tsx src/cli.ts scan",
    "protocols": "tsx src/cli.ts protocols",
    "dev": "tsx src/cli.ts",
    "dev:worker": "tsx src/worker.ts",
    "migrate": "node dist/migrate.js",
    "build:hacks": "tsx src/scripts/build-hack-db.ts && tsx src/scripts/extract-patterns.ts && tsx src/scripts/generate-known-hacks.ts",
    "build:hacks:scrape": "tsx src/scripts/build-hack-db.ts",
    "build:hacks:extract": "tsx src/scripts/extract-patterns.ts",
    "build:hacks:generate": "tsx src/scripts/generate-known-hacks.ts",
    "army": "tsx src/army/initialize-army.ts",
    "dashboard": "tsx src/army/battle-dashboard.ts",
    "deploy-army": "npm run army && npm run dashboard",
    "test-rpc": "tsx -e \"import { rpcTester } from './src/utils/rpc-tester'; rpcTester.testAllChains().then(results => rpcTester.generateReport(results))\"",
    "test-rpc-quick": "tsx -e \"import { quickTest } from './src/utils/rpc-tester'; quickTest()\"",
    "test-rpc-tier1": "tsx -e \"import { rpcTester } from './src/utils/rpc-tester'; rpcTester.testHighPriorityChains().then(results => rpcTester.generateReport(results))\""
  },
  "keywords": [
    "smart-contract",
    "security",
    "vulnerability-scanner",
    "defi",
    "slither"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^12.6.2",
    "bullmq": "^5.0.0",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.27.2"
  }
}
