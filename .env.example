# Required
ETHERSCAN_API_KEY=your_etherscan_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DATABASE_URL=postgresql://postgres:password@localhost:5432/scanner
REDIS_URL=redis://localhost:6379

# Recommended - Claude API for AI-augmented analysis
ANTHROPIC_API_KEY=your_anthropic_api_key

# Recommended - RPC URLs for PoC verification on forked mainnet
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
OPTIMISM_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_KEY

# Optional - Scanner config
MIN_TVL_THRESHOLD=10000000
SCAN_CHAINS=ethereum,base,arbitrum
ALERT_MIN_SEVERITY=medium

# Optional - AI cost controls (for cost-optimized continuous scanning)
# AI_MODEL_HAIKU=claude-haiku-4-20250414
# AI_MODEL_SONNET=claude-sonnet-4-20250514
# MIN_TVL_FOR_AI=1000000
# MIN_TVL_FOR_SONNET=50000000
# DISABLE_AI_ANALYSIS=false

# Legacy per-process rate limiting (DEPRECATED - use global rate limiting below)
# These are still respected for backwards compatibility but WR_AI_* vars are preferred
# MAX_AI_CALLS_PER_HOUR=20
# MAX_AI_SPEND_PER_DAY=1.00

# ══════════════════════════════════════════════════════════════════════════════
# GLOBAL AI RATE LIMITING (Redis-backed, recommended for multi-replica setups)
# ══════════════════════════════════════════════════════════════════════════════
#
# When running multiple worker replicas, each process previously had its own
# rate limits, causing bursts when replicas > 1. The new AI queue system
# centralizes all AI calls through a dedicated ai_worker service with global
# Redis-backed rate limiting.
#
# Architecture:
#   scanner (replicas: N) → enqueues AI jobs → Redis queue → ai_worker (replicas: 1)
#
# Benefits:
#   - Global rate limiting across all workers
#   - No API rate limit errors from burst requests
#   - Resilient retry with exponential backoff
#   - Circuit breaker for consecutive 429 errors

# Worker mode: scanner (discovery + enqueue), ai_worker (process AI queue), worker (legacy)
WR_MODE=scanner

# Enable AI queue mode (scanner enqueues, ai_worker processes)
# Set to 'false' to use legacy direct API calls (not recommended with replicas > 1)
WR_USE_AI_QUEUE=true

# Requests per minute - global limit across all ai_worker instances
# Anthropic's default rate limit is ~60 RPM, but we use conservative values
# to avoid hitting limits during bursts
WR_AI_RPM=2

# Minimum delay between API calls (milliseconds)
# Ensures even spacing of requests. At 12000ms = 5 calls/minute max
WR_AI_MIN_DELAY_MS=12000

# Maximum retry attempts per job before dropping
# Jobs that fail repeatedly are logged and discarded
WR_AI_MAX_ATTEMPTS=5

# Cooldown period after consecutive 429 errors (milliseconds)
# When the circuit breaker trips, all AI calls pause for this duration
WR_AI_COOLDOWN_MS=120000

# Number of consecutive 429 errors before entering cooldown
WR_AI_429_THRESHOLD=3

# Optional - Additional RPC URLs for wallet verification (12 chains supported)
BSC_RPC_URL=https://bsc-dataseed.binance.org
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
FANTOM_RPC_URL=https://rpc.ftm.tools
LINEA_RPC_URL=https://rpc.linea.build
SCROLL_RPC_URL=https://rpc.scroll.io
BLAST_RPC_URL=https://rpc.blast.io
GNOSIS_RPC_URL=https://rpc.gnosischain.com

# Optional - Wallet for enhanced 4-stage verification (simulation only, no mainnet)
# Set either WALLET_ENCRYPTION_PASSWORD or WALLET_PASSWORD_FILE (not both)
WALLET_ENCRYPTION_PASSWORD=your_strong_encryption_password
# WALLET_PASSWORD_FILE=/path/to/password/file

# Optional - Intelligence layer (pattern learning & fork hunting)
PATTERN_DB_PATH=~/.etherscan-auditor/patterns.db
EVOLUTION_INTERVAL_HOURS=24
MIN_PATTERNS_FOR_EVOLUTION=5
MAX_CHAINS_TO_SEARCH=20
MIN_FORK_SIMILARITY=0.7

# Optional - Clawd bot integration
CLAWD_AGENT_ID=white-rabbit
CLAWD_DELIVERY_CHANNEL=telegram
