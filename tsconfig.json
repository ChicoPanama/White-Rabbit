{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "cache",
    "src/cached-scanner.ts",
    "src/cli-cached.ts",
    "src/cli-fixed.ts",
    "src/cli-fork-hunter.ts",
    "src/debug-tvl.ts",
    "src/analyzers/cached-analyzer.ts",
    "src/clients/cached-defillama.ts",
    "src/clients/cached-etherscan.ts",
    "src/services/fork-hunter-advanced.ts",
    "src/services/decompiler.ts",
    "src/scripts/**/*",
    "src/tests/**/*"
  ]
}
